# OS — ignore local noise
desktop.ini
Thumbs.db
.DS_Store
*.tmp
~$*
*.bak

# Secrets and credentials (never commit)
.env
.env.*
*.pem
*credentials*
*secret*

# Intake staging (optional — remove if you want inbox tracked)
intake/inbox/*
!intake/inbox/.gitkeep

# Large binaries — register in sources/registry.md instead of committing
*.mp4
*.zip
*.pptx
*.xlsx
*.exe
*.7z

# Allow portable release packages (tracked via Git LFS)
!poc/desktop/MedVerse-Portable-v0.4.zip
!poc/desktop/MedVerse-Mac-Portable-v0.4.zip

# Electron build artifacts
poc/desktop/installer/
poc/desktop/node_modules/

# Old release snapshots
poc/MedVerse-v0.3/

# Dependencies and build caches
node_modules/
.vite/

# Cursor / IDE
.cursor/
.claude/

# Assembled GitHub Pages output (see .github/workflows/deploy-pages.yml)
site/

# Internal research — NEVER commit. This repository is PUBLIC.
# evidence-internal/ holds the full-fidelity HCP preferences page and deck: licensed
# analyst figures (TGaS/Trinity, McKinsey, Capgemini, ZS, HealthXL), verbatim
# advisory-board quotes marked not-for-distribution, unpublished traffic and CTR data,
# and named employees. It is served to Sanofi staff via OneDrive/SharePoint sign-in,
# not from this repo. The sanitised, publishable version is poc/hcp-preferences-public/.
evidence-internal/
*FULL-INTERNAL*
EVIDENCE-SYNTHESIS.md
