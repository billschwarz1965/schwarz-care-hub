# OS — ignore local noise
desktop.ini
Thumbs.db
.DS_Store
*.tmp
~$*
*.bak

# Secrets and credentials (never commit)
.env
.env.*
*.pem
*credentials*
*secret*

# Intake staging (optional — remove if you want inbox tracked)
intake/inbox/*
!intake/inbox/.gitkeep

# Large binaries — register in sources/registry.md instead of committing
*.mp4
*.zip
*.pptx
*.xlsx
*.exe
*.7z

# Electron build artifacts
poc/desktop/installer/
poc/desktop/node_modules/

# Old release snapshots
poc/MedVerse-v0.3/

# Dependencies and build caches
node_modules/
.vite/

# Cursor / IDE
.cursor/
.claude/
